# ==============================================================================
# ILERTI HEALTH — PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# Core App URL
NEXT_PUBLIC_APP_URL=https://ilertihealth.site
NEXT_PUBLIC_API_URL=https://ilertihealth.site

# --- Database & Persistence ---
# PostgreSQL Connection URL (Supabase, Neon, AWS RDS, or Vercel Postgres)
DATABASE_URL=postgresql://user:password@host:5432/ilerti_db?sslmode=require
POSTGRES_URL=postgresql://user:password@host:5432/ilerti_db?sslmode=require

# --- Authentication & Security ---
JWT_SECRET=super-secure-production-jwt-secret-min-32-chars-long
ADMIN_SECRET_KEY=ILERTI-SYS-ADMIN-SECURE-KEY-2026

# --- Real-Time Google OAuth Redirect Flow ---
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
# Redirect URI authorized in Google Cloud: https://ilertihealth.site/api/auth/google/callback
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# --- Real-Time SMS OTP Dispatch (Termii Nigeria) ---
# Obtain from https://accounts.termii.com
TERMII_API_KEY=your-live-termii-api-key
TERMII_SENDER_ID=ILERTI

# --- Real-Time Email OTP & Transactional Email (Resend) ---
# Obtain from https://resend.com
RESEND_API_KEY=re_your_live_resend_api_key
EMAIL_FROM=ILERTI Health <security@ilertihealth.site>

# --- Payments & Consultations (Paystack Nigeria) ---
# Obtain from https://dashboard.paystack.com
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_live_your_live_paystack_public_key
PAYSTACK_SECRET_KEY=sk_live_your_live_paystack_secret_key

# --- AI Clinical Triage & Health Navigation ---
OPENAI_API_KEY=sk-proj-your-openai-api-key
