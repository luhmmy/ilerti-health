# ILERTI Health Environment Variables

# Server-Side Variables
# Get this from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk_test_...

# Paystack API Keys
# Get this from https://dashboard.paystack.com/
PAYSTACK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_...

# Database Connection (PostgreSQL)
# e.g., Supabase, Neon, or local Postgres
DATABASE_URL=postgresql://user:password@localhost:5432/ilerti?schema=public
